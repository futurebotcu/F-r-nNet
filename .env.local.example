# FırınNet — Local dev .env template
# Kullanım:
#   1. Bu dosyayı .env.local olarak kopyalayın.
#   2. Aşağıdaki değerleri Supabase Project Settings → API'den doldurun.
#   3. anon (publishable) anahtarı kullanın — admin/yönetici anahtarı ASLA bu dosyaya koymayın.
#   4. .env.local git'e girmez (.gitignore tarafından dışlandı).
#
# Boşluk veya tırnak gerekmiyor; tek satır KEY=DEĞER yeterli.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
