<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FırınNet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>firin_defter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- V1.4 — Supabase OAuth (Google / Apple) deep link callback.
	     redirectTo: firinnet://auth-callback (bkz. AppConfig.authRedirectUrl).
	     Apple Sign-In native akış için ayrıca "Sign in with Apple" capability
	     Xcode signing tab'ından aktif edilmelidir; bkz.
	     GOOGLE_APPLE_AUTH_V1_REPORT.md §Apple Developer requirements. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.firinnet.auth-callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>firinnet</string>
			</array>
		</dict>
	</array>
	<!-- App Store Prep Sprint 1 — image_picker (galeri/kamera) için zorunlu
	     iOS izin açıklamaları. Eksik olursa iOS'ta foto/kamera erişiminde
	     crash + App Store privacy reddi olur. video_player ek string istemez. -->
	<key>NSCameraUsageDescription</key>
	<string>FırınNet uses the camera to let you add photos and videos to posts, stories, marketplace listings, chats, and your profile.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FırınNet uses the microphone to record audio when you capture a video to share in chats and groups.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FırınNet uses your photo library so you can choose images for posts, stories, marketplace listings, and your profile.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>FırınNet may save images to your photo library when you choose to do so.</string>
</dict>
</plist>
