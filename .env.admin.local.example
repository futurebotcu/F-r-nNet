# FırınNet — Supabase admin (service_role) .env template
# UYARI: Bu dosya yalnızca local admin script'leri ve geçici Auth Admin işleri içindir.
#
# Kurallar:
#   • service_role ANAHTARI ASLA Flutter app'e (--dart-define) verilmez.
#   • Bu anahtar mobile binary'ye gömülürse RLS bypass edilir → P0 güvenlik.
#   • .env.admin.local git'e girmez (.gitignore tarafından dışlandı).
#   • Anahtarı paylaşım kanallarına yazmayın; sadece bu dosyaya.
#   • Üretim için kullanmayın; sadece tek-makineli local dev/audit.
#
# Anahtarı nereden alırsınız:
#   Supabase Dashboard → Project Settings → API → "service_role" (gizli)
#
# Kullanım:
#   .\scripts\admin\check_admin_access.ps1

SUPABASE_URL=https://sjeqwiqgwzagengdukye.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
